# Flask Secret Key
SECRET_KEY=replace_with_a_random_secret

# Supabase PostgreSQL Connection URL
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Or Pooler URL: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=your_supabase_postgresql_connection_string

# Optional: n8n automation webhook triggered on new link creation
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/linksphere
